geom_point(aes(x = YEAR, y = CAPACITY / 10^3, color = TR, shape = TR), size = 2) +
geom_hline(yintercept = 0, linewidth = 0.2, color = 'grey60') +
scale_color_manual(values = line_color) +
scale_shape_manual(values = shape) +
labs(
x = "Year",
